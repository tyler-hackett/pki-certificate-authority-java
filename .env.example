# Copy to .env, fill in real values, then export them: set -a; source .env; set +a
# .env is gitignored; never commit it. Every value below is a placeholder.

# Read by certs-offline and certs-online at startup.
CA_ROOT_KEYSTORE_PASSWORD=changeme
CA_ROOT_KEY_PASSWORD=changeme
CA_ONLINE_KEYSTORE_PASSWORD=changeme
CA_ONLINE_KEY_PASSWORD=changeme

# Read by caf-webapp to open the server keystore. Use the values you pass to
# genserverkeystore as --keystorepass and --keypass.
SERVER_KEYSTORE_PASSWORD=changeme
SERVER_KEY_PASSWORD=changeme
